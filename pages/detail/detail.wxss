.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: stretch;
  background: linear-gradient(135deg, #ff6b35, #ff8f3c);
  border-radius: 24rpx;
  overflow: hidden;
  color: #ffffff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.28);
}

.hero-left {
  width: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 20rpx;
  border-right: 2rpx dashed rgba(255, 255, 255, 0.4);
  flex-shrink: 0;
}

.face-value {
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.3;
}

.hero-right {
  flex: 1;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.platform {
  font-size: 26rpx;
  opacity: 0.9;
}

.section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.desc {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 26rpx;
  color: #999999;
}

.row-value {
  font-size: 26rpx;
  color: #333333;
}

.code {
  color: #ff6b35;
  font-weight: 600;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
}

.btn-secondary {
  background: #ffffff;
  color: #ff6b35;
  border: 2rpx solid #ff6b35;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 86rpx;
  text-align: center;
}

.btn-secondary:active {
  opacity: 0.85;
}

.btn-share {
  background: #f2f3f5;
  color: #555555;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 86rpx;
  text-align: center;
  padding: 0;
  margin: 0;
}

.btn-share::after {
  border: none;
}

.btn-share:active {
  opacity: 0.85;
}
